{
  "manifest_version": 3,
  "name": "Easy Mouse Macro",
  "version": "1.0.0",
  "description": "Record mouse movements, clicks and wheel scrolling — plus TAB and SPACE — inside a browser tab, then replay them at any speed.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Easy Mouse Macro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Open the Easy Mouse Macro popup"
    },
    "emm-toggle-record": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Start or stop recording the mouse in the current tab"
    },
    "emm-stop-playback": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop the running replay"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["lib/macro-core.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
